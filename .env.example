# Copy to .env. Every value here has a working default; nothing is required to boot.

# Where the app listens.
PORT=8767
HOST=127.0.0.1

# libSQL / Turso. A local file today; add TURSO_* to sync to the cloud later.
DATABASE_URL=file:./data/lab.db
# TURSO_SYNC_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# The NeMo Gym checkout we drive. Must contain .venv/bin/gym and env.yaml.
GYM_ROOT=/home/chris/Documents/recursive_lab/gym

# The head server `gym env start` brings up in that checkout. Every other gym
# server is discovered through it, so this is the only gym port we know.
GYM_HEAD_URL=http://127.0.0.1:11000
GYM_TIMEOUT_MS=5000
